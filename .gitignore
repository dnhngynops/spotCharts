# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# Node
node_modules/
frontend/dist/
# Un-ignore frontend/src/lib/ — 'lib/' above is a Python build artifact pattern
!frontend/src/lib/
!frontend/src/lib/**

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project-specific
backend copy/
credentials/google-drive-credentials.json
token.pickle
data/*
!data/README.md
output/*
!output/README.md
logs/*
!logs/README.md

# Generated reports (HTML/PDF)
*.html
*.pdf
!templates/*.html
!templates/**/*.html
# Allow the Vite entry point and the root index for gh-pages
!frontend/index.html
!index.html
# Allow full GitHub Pages build output (React assets + data.json)
!docs/
!docs/**

# Test outputs
tests/output/*
tests/*.log
tests/*.pdf
tests/*.html

# Temporary files
*.log

# Selenium/Browser cache
.cache
